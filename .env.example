# Set these environment variables before starting TaskNet.
TASKNET_SECRET_KEY=replace-with-a-long-random-secret
TASKNET_BASE_URL=http://127.0.0.1:5000/
TASKNET_SMTP_HOST=smtp.example.com
TASKNET_SMTP_PORT=587
TASKNET_SMTP_USER=your-smtp-username
TASKNET_SMTP_PASSWORD=your-smtp-password-or-app-password
TASKNET_FROM_EMAIL=verified-sender@example.com
# Set to 1 only when deployed behind HTTPS.
TASKNET_HTTPS=0
